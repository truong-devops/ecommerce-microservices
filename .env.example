# Public web origins
BUYER_WEB_BASE_URL=https://shop.truongam.tech
SELLER_WEB_BASE_URL=https://seller.truongam.tech
MODERATOR_WEB_BASE_URL=https://moderator.truongam.tech
FRONTEND_BIND_ADDRESS=127.0.0.1

# Public API and realtime endpoints embedded into frontend builds
NEXT_PUBLIC_API_GATEWAY_WS_URL=wss://api.truongam.tech/api/v1
NEXT_PUBLIC_CHAT_WS_BASE_URL=https://api.truongam.tech

# Google OAuth web client (never commit real credentials)
GOOGLE_OAUTH_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace-me
GOOGLE_OAUTH_REDIRECT_URI=https://api.truongam.tech/api/v1/auth/oauth/google/callback

# Browser access policies
CORS_ALLOWED_ORIGINS=https://shop.truongam.tech,https://seller.truongam.tech,https://moderator.truongam.tech
WS_ALLOWED_ORIGINS=https://shop.truongam.tech,https://seller.truongam.tech

# Object storage public endpoint
MINIO_ROOT_USER=replace-me
MINIO_ROOT_PASSWORD=replace-me
MINIO_PUBLIC_ENDPOINT=media.truongam.tech
MINIO_PUBLIC_USE_SSL=true
MEDIA_PUBLIC_BASE_URL=https://media.truongam.tech/ecommerce-media
RUSTFS_CORS_ALLOWED_ORIGINS=https://shop.truongam.tech,https://seller.truongam.tech,https://moderator.truongam.tech
RUSTFS_CONSOLE_CORS_ALLOWED_ORIGINS=https://shop.truongam.tech,https://seller.truongam.tech,https://moderator.truongam.tech

# MediaMTX URLs returned to browsers. Publish live-media.truongam.tech before enabling these.
LIVE_MEDIA_INGEST_BASE_URL=https://live-media.truongam.tech
LIVE_MEDIA_PLAYBACK_BASE_URL=https://live-media.truongam.tech
# Must be an IP reachable by viewers (public IP, VPN IP, or TURN-backed deployment).
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=replace-with-reachable-server-ip

# SePay outgoing webhook used to confirm seller payouts automatically.
SEPAY_PAYOUT_WEBHOOK_ENABLED=false
SEPAY_PAYOUT_SOURCE_ACCOUNT_NUMBER=replace-with-platform-bank-account
SEPAY_PAYOUT_WEBHOOK_AUTH_MODE=hmac
SEPAY_PAYOUT_WEBHOOK_SECRET=replace-with-random-hmac-secret
