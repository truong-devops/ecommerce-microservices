# Payment provider used by payment-service. Use mock only for isolated local tests.
PAYMENT_GATEWAY=sepay

# SePay QR payment configuration.
SEPAY_ENVIRONMENT=test
SEPAY_BANK_CODE=replace-with-bank-code
SEPAY_BANK_ACCOUNT_NUMBER=replace-with-bank-account-number
SEPAY_BANK_ACCOUNT_NAME=replace-with-account-holder-name
SEPAY_ALLOWED_ACCOUNT_NUMBERS=replace-with-bank-account-number
SEPAY_PAYMENT_CODE_PREFIX=EMX
SEPAY_TRANSFER_DESCRIPTION_TEMPLATE={paymentCode} thanh toan don {orderCode}
SEPAY_QR_TEMPLATE=compact
SEPAY_PAYMENT_EXPIRES_MINUTES=15

# Incoming payment webhook authentication.
SEPAY_WEBHOOK_AUTH_MODE=hmac
SEPAY_WEBHOOK_SECRET=replace-with-random-hmac-secret
SEPAY_WEBHOOK_SECRETS=
SEPAY_WEBHOOK_API_KEY=
SEPAY_TIMESTAMP_TOLERANCE_SECONDS=300

# Optional transaction reconciliation through SePay User API.
SEPAY_API_BASE_URL=https://my.sepay.vn/userapi
SEPAY_API_TOKEN=
SEPAY_RECONCILE_ENABLED=false
SEPAY_RECONCILE_INTERVAL_MS=1800000
SEPAY_RECONCILE_BATCH_SIZE=100
