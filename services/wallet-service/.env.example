APP_NAME=wallet-service
APP_ENV=development
PORT=3015
API_PREFIX=api/v1
DATABASE_URL=postgresql://ewallet:ewallet@localhost:5432/ecommerce_wallet
JWT_ACCESS_SECRET=dev-shared-jwt-access-secret-min-32-chars
BANK_ACCOUNT_ENCRYPTION_KEY=dev-wallet-bank-account-encryption-key-32-chars

WALLET_HOLD_DURATION_SECONDS=60
WALLET_RELEASE_INTERVAL_MS=5000
WALLET_RELEASE_BATCH_SIZE=100

PAYOUT_ENABLED=true
PAYOUT_PROVIDER=manual_vietqr
MOCK_PAYOUT_MODE=success
PAYOUT_MIN_AMOUNT_VND=10000
PAYOUT_MAX_AMOUNT_VND=10000000
PAYOUT_WORKER_INTERVAL_MS=2000
PAYOUT_WORKER_BATCH_SIZE=20
PAYOUT_RECONCILE_INTERVAL_MS=5000
PAYOUT_STALE_AFTER_SECONDS=30
PAYOUT_IDEMPOTENCY_TTL_HOURS=24

KAFKA_ENABLED=false
KAFKA_CLIENT_ID=wallet-service
KAFKA_BROKERS=localhost:9092
KAFKA_START_OFFSET=first
PAYMENT_EVENTS_TOPIC=payment.events
PAYMENT_EVENTS_CONSUMER_GROUP=wallet-service-payment-events-group
ORDER_EVENTS_TOPIC=order.events
ORDER_EVENTS_CONSUMER_GROUP=wallet-service-order-events-group
WALLET_EVENTS_TOPIC=wallet.events

OUTBOX_DISPATCH_INTERVAL_MS=3000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_RETRY=10

DB_MIGRATIONS_RUN=true
MIGRATION_FILE=migrations/0001_init_wallet_service.sql

